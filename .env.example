# Postgres (Neon). El pooler de Neon no soporta prepared statements; el cliente
# ya se configura con prepare: false.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.us-east-2.aws.neon.tech/descolga?sslmode=require"

# Firma de la cookie de sesión y de los tokens de acción de las notificaciones.
# Generar con: npm run vapid
SESSION_SECRET=""

# Web Push (VAPID). Generar con: npm run vapid
# Cambiarlas invalida todas las suscripciones existentes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@descolga.app"

# Protege /api/cron/tick. Vercel Cron lo manda como `Authorization: Bearer …`.
CRON_SECRET=""

# Usada por scripts/tick.mjs y para armar URLs absolutas.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
